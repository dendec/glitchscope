+auto Shader::ParallelCompileExtension() -> const char*
+{
+    // projectM requires GL 3.3 / GLES 3.0. Indexed enumeration also works in
+    // core contexts, where glGetString(GL_EXTENSIONS) is invalid.
+    GLint count{};
+    glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+    bool arb = false;
+    for (GLint i = 0; i < count; ++i)
+    {
+        const auto* extension = reinterpret_cast<const char*>(glGetStringi(GL_EXTENSIONS, i));
+        if (extension == nullptr)
+        {
+            continue;
+        }
+        if (std::string(extension) == "GL_KHR_parallel_shader_compile")
+        {
+            return "KHR";
+        }
+        arb = arb || std::string(extension) == "GL_ARB_parallel_shader_compile";
+    }
+    // ARB and KHR use the same completion-status token and query semantics.
+    return arb ? "ARB" : "";
