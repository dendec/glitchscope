+// This function runs entirely on the caller's dedicated shared GL context.
+// It never accesses Shader instances or the active projectM render state.
+void Shader::RunWorker()
+{
+    for (;;)
+    {
+        std::shared_ptr<CompileJob> job;
+        {
+            std::unique_lock<std::mutex> lock(CompileJob::mutex);
+            CompileJob::wake.wait(lock, [] { return CompileJob::stopping || !CompileJob::queue.empty(); });
+            if (CompileJob::stopping)
+            {
+                CompileJob::queue.clear();
+                return;
+            }
+            job = CompileJob::queue.front().lock();
+            CompileJob::queue.pop_front();
+        }
+        if (!job) continue; // Cancelled before compilation started.
+        GLuint vertex{}, fragment{};
+        try
+        {
+            if (job->sourceFactory)
+            {
+                auto sourceFactory = std::move(job->sourceFactory);
+                auto sources = sourceFactory();
+                job->vertexSource = std::move(sources.first);
+                job->fragmentSource = std::move(sources.second);
+            }
+            const auto compile = [](const std::string& source, GLenum type) {
+                GLuint shader = glCreateShader(type);
+                const auto* text = source.c_str();
+                glShaderSource(shader, 1, &text, nullptr);
+                glCompileShader(shader);
+                GLint success{};
+                glGetShaderiv(shader, GL_COMPILE_STATUS, &success);
+                if (!success)
+                {
+                    GLint size{};
+                    glGetShaderiv(shader, GL_INFO_LOG_LENGTH, &size);
+                    std::vector<char> message(size + 1);
+                    glGetShaderInfoLog(shader, size, nullptr, message.data());
+                    glDeleteShader(shader);
+                    throw ShaderException("Worker shader compile: " + std::string(message.data()));
+                }
+                return shader;
+            };
+            vertex = compile(job->vertexSource, GL_VERTEX_SHADER);
+            fragment = compile(job->fragmentSource, GL_FRAGMENT_SHADER);
+            job->program = glCreateProgram();
+            glAttachShader(job->program, vertex);
+            glAttachShader(job->program, fragment);
+            glLinkProgram(job->program);
+            GLint linked{};
+            glGetProgramiv(job->program, GL_LINK_STATUS, &linked);
+            if (!linked)
+            {
+                GLint size{};
+                glGetProgramiv(job->program, GL_INFO_LOG_LENGTH, &size);
+                std::vector<char> message(size + 1);
+                glGetProgramInfoLog(job->program, size, nullptr, message.data());
+                throw ShaderException("Worker program link: " + std::string(message.data()));
+            }
+            glDetachShader(job->program, vertex);
+            glDetachShader(job->program, fragment);
+        }
+        catch (const std::exception& ex)
+        {
+            job->error = ex.what();
+        }
+        if (vertex) glDeleteShader(vertex);
+        if (fragment) glDeleteShader(fragment);
+        // Complete the producer context before publishing shared objects.
+        // Any driver wait occurs here, never in the UI poll/commit path.
+        glFinish();
+        job->ready.store(true, std::memory_order_release);
+    }
+}
