+static auto TranspileHLSLShader(MilkdropShader::ShaderType type,
+                                const std::string& program,
+                                const std::vector<std::string>& samplerDeclarations,
+                                const std::vector<std::string>& texSizeDeclarations,
+                                M4::GLSLGenerator::Version glslVersion) -> std::string
+{
+    const auto shaderTypeString = type == MilkdropShader::ShaderType::WarpShader ? "warp" : "composite";
+
+    M4::GLSLGenerator generator;
+    M4::Allocator allocator;
+    M4::HLSLTree tree(&allocator);
+    M4::HLSLParser parser(&allocator, &tree);
+
+    std::string sourcePreprocessed;
+    if (!parser.ApplyPreprocessor("", program.c_str(), program.size(), sourcePreprocessed))
+    {
+        throw Renderer::ShaderException("Error translating HLSL " + std::string(shaderTypeString) +
+                                        " shader: Preprocessing failed.\nSource:\n" + program);
+    }
+
+    std::smatch matches;
+    while (std::regex_search(sourcePreprocessed, matches, std::regex("sampler(2D|3D|)(\\s+|\\().*")))
+    {
+        sourcePreprocessed.replace(matches.position(), matches.length(), "");
+    }
+    while (std::regex_search(sourcePreprocessed, matches, std::regex("float4\\s+texsize_.*")))
+    {
+        sourcePreprocessed.replace(matches.position(), matches.length(), "");
+    }
+
+    for (const auto& declaration : texSizeDeclarations)
+    {
+        sourcePreprocessed.insert(0, declaration);
+    }
+    for (const auto& declaration : samplerDeclarations)
+    {
+        sourcePreprocessed.insert(0, declaration);
+    }
+
+    if (!parser.Parse("", sourcePreprocessed.c_str(), sourcePreprocessed.size()))
+    {
+        throw Renderer::ShaderException("Error translating HLSL " + std::string(shaderTypeString) +
+                                        " shader: HLSL parsing failed.\nSource:\n" + sourcePreprocessed);
+    }
+    if (!generator.Generate(&tree, M4::GLSLGenerator::Target_FragmentShader, glslVersion, "PS",
+                            M4::GLSLGenerator::Options(M4::GLSLGenerator::Flag_AlternateNanPropagation)))
+    {
+        throw Renderer::ShaderException("Error translating HLSL " + std::string(shaderTypeString) +
+                                        " shader: GLSL generating failed.\nSource:\n" + sourcePreprocessed);
+    }
+    return generator.GetResult();
+}
