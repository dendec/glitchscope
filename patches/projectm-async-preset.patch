+bool ProjectM::BeginPresetLoad(const std::string& presetData, bool smoothTransition)
+{
+    m_pendingShaders.clear();
+    m_pendingPreset.reset();
+    m_presetLoadError.clear();
+    m_presetCreateMilliseconds = 0;
+    m_presetInitializeMilliseconds = 0;
+    m_presetInitializeTimings = {};
+    m_pendingPresetSmooth = smoothTransition;
+    m_presetLoadStatus = PresetLoadStatus::Failed;
+
+    Renderer::Shader::SetParallelCompileEnabled(true);
+    try
+    {
+        m_textureManager->PurgeTextures();
+        std::stringstream presetDataStream(presetData);
+        const auto started = std::chrono::steady_clock::now();
+        auto preset = m_presetFactoryManager->CreatePresetFromStream(".milk", presetDataStream);
+        const auto created = std::chrono::steady_clock::now();
+        m_presetCreateMilliseconds = std::chrono::duration<double, std::milli>(created - started).count();
+        preset->Initialize(GetRenderContext());
+        m_presetInitializeMilliseconds = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - created).count();
+        m_presetInitializeTimings = preset->InitializationTimings();
+        m_pendingShaders = Renderer::Shader::PreparedShaders();
+        m_pendingPreset = std::move(preset);
+        m_presetLoadStatus = PresetLoadStatus::Loading;
+    }
+    catch (const std::exception& ex)
+    {
+        m_presetLoadError = ex.what();
+    }
+    Renderer::Shader::SetParallelCompileEnabled(false);
+    return m_presetLoadStatus != PresetLoadStatus::Failed;
+}
+
+auto ProjectM::PollPresetLoad() -> PresetLoadStatus
+{
+    if (m_presetLoadStatus != PresetLoadStatus::Loading)
