# ARM64 PortMaster cross-build.
# Builds projectM from source with GLES, then links statically.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -q https://go.dev/dl/go1.25.4.linux-amd64.tar.gz -O /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/go/bin:$PATH

RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends \
        build-essential g++-aarch64-linux-gnu binutils-aarch64-linux-gnu cmake git \
        libsdl2-dev:arm64 \
        libgles2-mesa-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Create CMake toolchain file for cross-compilation
RUN echo 'set(CMAKE_SYSTEM_NAME Linux)\n\
set(CMAKE_SYSTEM_PROCESSOR aarch64)\n\
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)\n\
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)\n\
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)' > /build/toolchain.cmake

# Clone SoLoud (audio engine, no tag — master is stable)
RUN git clone --depth 1 https://github.com/jarikomppa/soloud.git lib/soloud

# Clone & patch projectM (v4.1.6 with feedback framebuffer injection)
RUN git clone --depth 1 --branch v4.1.6 \
    https://github.com/projectM-visualizer/projectm.git lib/projectm
COPY patches/ patches/
RUN cd lib/projectm \
    && git apply /build/patches/projectm-feedback.patch \
    && sed -i 's/#cmakedefine PROJECTM_VERSION_VCS @PROJECTM_VERSION_VCS@/#define PROJECTM_VERSION_VCS "Unknown"/' \
        config.h.cmake.in

# Build projectM static lib with GLES
RUN mkdir -p lib/projectm/build && cd lib/projectm/build && \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
    cmake .. -DCMAKE_TOOLCHAIN_FILE=/build/toolchain.cmake \
             -DBUILD_SHARED_LIBS=OFF \
             -DENABLE_PLAYLIST=OFF \
             -DENABLE_SDL_UI=OFF \
             -DBUILD_TESTING=OFF \
             -DCMAKE_BUILD_TYPE=Release \
             -DENABLE_INSTALL=OFF \
             -DENABLE_GLES=ON && \
    cmake --build . --target projectM -- -j$(nproc)

# Build Go app
COPY go.mod go.sum* ./
RUN go mod download 2>/dev/null || true

COPY . .

ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig

RUN CGO_ENABLED=1 GOOS=linux GOARCH=arm64 \
    CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ \
    CGO_CXXFLAGS="-std=c++11 -Wno-write-strings -DWITH_SDL2_STATIC -I ../../lib/soloud/include -I ../../lib/projectm/src/api/include -I ../../lib/projectm/build/src/api/include -I/usr/include/SDL2 -D_REENTRANT" \
    CGO_LDFLAGS="-lSDL2 -lm -lpthread lib/projectm/build/src/libprojectM/libprojectM-4.a lib/projectm/build/vendor/projectm-eval/projectm-eval/libprojectM_eval.a -lGLESv2 -lm" \
    go build -ldflags="-s -w" -o mdpp ./cmd/mdpp \
    && aarch64-linux-gnu-strip mdpp

# Prepare dist
RUN mkdir -p /dist/mdpp/presets \
    && cp mdpp /dist/mdpp/ \
    && cp test_data/presets/test.milk /dist/mdpp/presets/ \
    && cp portmaster/MDPP.sh /dist/ \
    && cp portmaster/port.json /dist/ \
    && cp portmaster/screenshot.png /dist/ 2>/dev/null; true \
    && mkdir -p /dist/mdpp/licenses \
    && cp portmaster/LICENSE* /dist/mdpp/licenses/ 2>/dev/null; true \
    && cp portmaster/README.md /dist/mdpp/

# Launcher wrapper
RUN printf '#!/bin/sh\nDIR="$(dirname "$0")"\nexport LD_LIBRARY_PATH="$DIR/lib:/usr/lib:$LD_LIBRARY_PATH"\n"$DIR/mdpp" "$DIR/song.mp3"\n' > /dist/mdpp/mdpp.sh \
    && chmod +x /dist/mdpp/mdpp.sh

RUN echo "=== Dist ===" && find /dist -type f -exec ls -lh {} \;
